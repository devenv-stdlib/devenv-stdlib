% coderabbit, ide

# Enable the CodeRabbit Open VSX extension tool
echo "tools.coderabbit.enable = true;" && home-switch

# Preset: extension + CLI (tools.coderabbit + tools.coderabbit-cli)
echo "presets.ide.coderabbit.enable = true;"

# Disable the extension after opting out
echo "tools.coderabbit.enable = false;" && home-switch
