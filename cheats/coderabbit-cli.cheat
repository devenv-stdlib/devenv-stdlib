% coderabbit-cli, ide

# Review local changes with the CodeRabbit CLI
coderabbit review

# Agent-oriented structured findings
coderabbit review --agent

# Check CLI install / local review readiness
coderabbit doctor

# Enable the CLI tool leaf (also in presets.ide.coderabbit)
echo "tools.coderabbit-cli.enable = true;" && home-switch

# Disable the CLI after opting out
echo "tools.coderabbit-cli.enable = false;" && home-switch
