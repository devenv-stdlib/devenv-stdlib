{ ... }:
{
  # Written by Copier from the devenv4monorepo questionnaire.
  # `copier update` re-asks those questions (defaults = last answers).
  # Add more options below; see devenv.local.nix.example.

  name = "{{ project_name }}";
{%- if "rust" in languages %}

  languages.rust.enable = true;
  supported.rust.min = "{{ rust_min }}";
{%- if rust_max %}
  supported.rust.max = "{{ rust_max }}";
{%- endif %}
{%- endif %}
{%- if "go" in languages %}

  languages.go.enable = true;
  supported.go.min = "{{ go_min }}";
{%- if go_max %}
  supported.go.max = "{{ go_max }}";
{%- endif %}
{%- endif %}
{%- if "python" in languages %}

  languages.python = {
    enable = true;
    version = "{{ python_min }}";
    venv.enable = {% if python_venv %}true{% else %}false{% endif %};
  };
  supported.python.min = "{{ python_min }}";
{%- if python_max %}
  supported.python.max = "{{ python_max }}";
{%- endif %}
  pythonTypeChecker = "{{ python_type_checker }}";
{%- if python_extension_toolchain %}
  python.extensionToolchain = true;
{%- endif %}
{%- endif %}
{%- if "javascript" in languages %}

  languages.javascript = {
    enable = true;
    npm.enable = {% if javascript_npm %}true{% else %}false{% endif %};
  };
{%- endif %}
{%- if "typescript" in languages %}

  languages.typescript.enable = true;
  typescript.bundler = "{{ typescript_bundler }}";
{%- endif %}
{%- if "javascript" in languages or "typescript" in languages %}

  supported.javascript.runtimes = [
{%- for runtime in javascript_runtimes %}
    "{{ runtime }}"
{%- endfor %}
  ];
{%- if "nodejs" in javascript_runtimes %}
  supported.javascript.nodejs.min = "{{ nodejs_min }}";
{%- if nodejs_max %}
  supported.javascript.nodejs.max = "{{ nodejs_max }}";
{%- endif %}
{%- endif %}
{%- if "bun" in javascript_runtimes %}
  supported.javascript.bun.min = "{{ bun_min }}";
{%- if bun_max %}
  supported.javascript.bun.max = "{{ bun_max }}";
{%- endif %}
{%- endif %}
{%- if "deno" in javascript_runtimes %}
  supported.javascript.deno.min = "{{ deno_min }}";
{%- if deno_max %}
  supported.javascript.deno.max = "{{ deno_max }}";
{%- endif %}
{%- endif %}
{%- endif %}
}
