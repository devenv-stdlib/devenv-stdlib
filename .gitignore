# Devenv
.devenv
.devenv*
# devenv.local.nix is gitignored here (template development). Generated
# monorepos use .gitignore.jinja, which commits that file.
devenv.local.nix
devenv.local.yaml
home.local.nix

# SecretSpec dotenv (9Router password, Brave / Firecrawl). Copier may write this.
.env

# Consumer hook for `update` (uv/npx extras). Template pins stay in-tree.
update.local.sh

# direnv
.direnv

# pre-commit (generated by git-hooks.nix)
.pre-commit-config.yaml

# Nix build leftovers
result
result-*

# Generated from languages.* by modules/cursor-languages.nix
.vscode/extensions.json

# Generated from languages.* by modules/serena-languages.nix
.serena/project.yml
# User override (Serena merges this over project.yml)
.serena/project.local.yml

# Generated from languages.* and debtmap.* by modules/debtmap.nix
.debtmap.toml

# lychee link-check cache (git-hooks)
.lycheecache

# JUnit reports from test-devenv
/junit/

# Local act / test-devenv transcripts
/act_run.log

# Documentation site
/docs/node_modules/
/docs/dist/
